# Copy to private.auto.tfvars (gitignored) and fill in. For CI, paste the same
# file content into the infra repo secret TOFU_PRIVATE_TFVARS.
# Not secrets (those live in Secret Manager) — just values we don't publish.
#
# Database settings are NOT here: run scripts/configure-neon-uat.ps1, which
# writes tofu/neon.auto.tfvars and stores the password in Secret Manager.

cph_env_private = {
  GOOGLE_CLIENT_ID         = "<...>.apps.googleusercontent.com"
  R2_ENDPOINT              = "https://<account>.r2.cloudflarestorage.com"
  MAIL_USERNAME            = "<smtp user>"
  WHATSAPP_PHONE_NUMBER_ID = ""
  SPRING_DATA_REDIS_HOST   = "<name>.upstash.io"
}
